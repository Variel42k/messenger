# Скопируйте в /etc/systemd/system/messenger.service и измените WorkingDirectory.
# Unit позволяет systemd запускать Compose stack после reboot.

[Unit]
Description=Messenger Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/messenger
RemainAfterExit=yes
TimeoutStartSec=0
ExecStart=/usr/bin/docker compose -f docker-compose.production.yml up -d --build
ExecStop=/usr/bin/docker compose -f docker-compose.production.yml stop
ExecReload=/usr/bin/docker compose -f docker-compose.production.yml up -d --build

[Install]
WantedBy=multi-user.target
