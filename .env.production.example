# Скопируйте в .env на production-like host и замените все placeholders.

POSTGRES_DB=messenger
POSTGRES_USER=messenger
POSTGRES_PASSWORD=change-this-postgres-password

DB_NAME=messenger
DB_USERNAME=messenger
DB_PASSWORD=change-this-postgres-password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=replace-with-output-of-openssl-rand-base64-64
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

STORAGE_PROVIDER=s3
STORAGE_DISK_PATH=/data/uploads
S3_ENDPOINT=https://minio.example.com
S3_ACCESS_KEY=replace-this-access-key
S3_SECRET_KEY=replace-this-secret-key
S3_BUCKET_NAME=messenger-files
S3_REGION=us-east-1
S3_PATH_STYLE_ACCESS_ENABLED=true
S3_AUTO_CREATE_BUCKET=false

CORS_ALLOWED_ORIGINS=https://chat.example.com
WS_ALLOWED_ORIGINS=https://chat.example.com

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_WEB_URL=
